{
  "opencollection": "1.0.0",
  "info": {
    "name": "3PL Warehouse Manager (SecureWMS) REST Authentication Items API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List a customer's SKU items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure-wms.com/customers/:customerId/items",
            "params": [
              {
                "name": "customerId",
                "value": "",
                "type": "path",
                "description": "The customer identifier."
              },
              {
                "name": "pgnum",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)."
              },
              {
                "name": "pgsiz",
                "value": "",
                "type": "query",
                "description": "Page size (records per page)."
              },
              {
                "name": "rql",
                "value": "",
                "type": "query",
                "description": "Resource Query Language filter, e.g. \"readonly.lastModifiedDate=ge=2024-01-01\". Reference http://api.3plcentral.com/rels/rql."
              },
              {
                "name": "sort",
                "value": "",
                "type": "query",
                "description": "Field to sort by, e.g. ReadOnly.lastModifiedDate or receivedDate."
              }
            ]
          },
          "docs": "Lists the SKU items defined for a customer. Paged/filterable/sortable (e.g. ReadOnly.lastModifiedDate). CONFIRMED (GET /customers/{id}/items)."
        }
      ]
    }
  ],
  "bundled": true
}