      "name": "Authentication",
      "description": {
        "content": "OAuth 2.0 client-credentials token issuance.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "ce4b834e-88ea-475a-b3c6-78c5a0536573",
          "name": "Issue an OAuth 2.0 access token",
          "request": {
            "name": "Issue an OAuth 2.0 access token",
            "description": {
              "content": "Exchanges Base64-encoded client credentials (Basic auth header) for a short-lived bearer access token using the client_credentials grant. CONFIRMED against the Extensiv \"Providing REST API Access\" documentation.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "AuthServer",
                "api",
                "Token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"grant_type\": \"<string>\",\n  \"user_login_id\": \"<integer>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "2620665e-3cbf-433a-9079-be5281ff149e",
              "name": "An access token.",
              "originalRequest": {
                "url": {
                  "path": [
                    "AuthServer",
                    "api",
                    "Token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"grant_type\": \"client_credentials\",\n  \"user_login_id\": \"<integer>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"access_token\": \"string\",\n  \"token_type\": \"Bearer\",\n  \"expires_in\": 5524\n}",
              "cookie": [],
