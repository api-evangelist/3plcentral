{
  "opencollection": "1.0.0",
  "info": {
    "name": "3PL Warehouse Manager (SecureWMS) REST Authentication Receivers API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Receivers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List receivers (ASN)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure-wms.com/inventory/receivers",
            "params": [
              {
                "name": "pgnum",
                "value": "",
                "type": "query",
                "description": "Page number (1-based)."
              },
              {
                "name": "pgsiz",
                "value": "",
                "type": "query",
                "description": "Page size (records per page)."
              },
              {
                "name": "rql",
                "value": "",
                "type": "query",
                "description": "Resource Query Language filter, e.g. \"readonly.lastModifiedDate=ge=2024-01-01\". Reference http://api.3plcentral.com/rels/rql."
              }
            ]
          },
          "docs": "Lists inbound receivers (Advance Ship Notices). A receiver can be looked up by tracking/reference number via rql. DOCUMENTED (GET /inventory/receivers); response is MODELED here."
        },
        {
          "info": {
            "name": "Create a receiver (ASN)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://secure-wms.com/inventory/receivers",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates an inbound receiver (Advance Ship Notice) the warehouse will receive goods against. DOCUMENTED (POST /inventory/receivers); request body is MODELED here."
        },
        {
          "info": {
            "name": "Retrieve a receiver (ASN)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://secure-wms.com/inventory/receivers/:receiverId",
            "params": [
              {
                "name": "receiverId",
                "value": "",
                "type": "path",
                "description": "The receiver (ASN) identifier."
              }
            ]
          },
          "docs": "Retrieves a single inbound receiver by id. DOCUMENTED (GET /inventory/receivers/{id}); response is MODELED here."
        }
      ]
    }
  ],
  "bundled": true
}